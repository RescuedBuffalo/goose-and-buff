# Godot 4 — editor and import caches
.godot/
.import/

# Godot reimport sidecars under design/ — that folder holds design-system
# source (HTML / JSX / CSS). Godot writes *.import metadata when it scans
# the tree, but those files are machine-local and noisy in a diff. Real
# game assets under assets/ keep their import sidecars tracked.
design/**/*.import

# Per-developer Godot tooling — godot-mcp helper plugin is installed
# locally for live editor control during AI-assisted iteration.
/addons/godot_mcp/

# Exported builds
build/
exports/
*.pck
*.exe
*.app
*.dmg
*.zip

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# User save data (don't ship these)
saves/
user_data/

# Roblox leftovers (in case any survive)
*.rbxl
*.rbxlx
*.rbxm
*.rbxmx
sourcemap.json
Packages/
ServerPackages/
DevPackages/

# Aftman tool installs (legacy Roblox toolchain)
.aftman/
