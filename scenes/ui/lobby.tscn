[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/lobby.gd" id="1"]

[node name="Lobby" type="Control"]
script = ExtResource("1")
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 0

[node name="Background" type="ColorRect" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.07, 0.07, 0.09, 1)
mouse_filter = 2

[node name="Margin" type="MarginContainer" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_constants/margin_left = 80
theme_override_constants/margin_top = 80
theme_override_constants/margin_right = 80
theme_override_constants/margin_bottom = 80
mouse_filter = 2

[node name="V" type="VBoxContainer" parent="Margin"]
theme_override_constants/separation = 24
mouse_filter = 2

[node name="Header" type="VBoxContainer" parent="Margin/V"]
theme_override_constants/separation = 4

[node name="Eyebrow" type="Label" parent="Margin/V/Header"]
text = "THE LONG WATCH"
theme_override_font_sizes/font_size = 12
theme_override_colors/font_color = Color(0.62, 0.55, 0.4, 1)

[node name="Title" type="Label" parent="Margin/V/Header"]
text = "Light a lantern, or follow one"
theme_override_font_sizes/font_size = 34
theme_override_colors/font_color = Color(0.99, 0.96, 0.89, 1)

[node name="Subtitle" type="Label" parent="Margin/V/Header"]
text = "Host the watch and share the code, or join with a code from your host."
theme_override_font_sizes/font_size = 16
theme_override_colors/font_color = Color(0.84, 0.8, 0.74, 1)

[node name="CodeRow" type="HBoxContainer" parent="Margin/V"]
theme_override_constants/separation = 16
alignment = 1

[node name="HostButton" type="Button" parent="Margin/V/CodeRow"]
