[gd_scene load_steps=3 format=3]

; Bipedal character rig template (BUF-183).
;
; Skeleton2D origin is at the character's feet (bottom-center anchor convention
; from BUF-181). Bone positions are placeholder values for an ~50px-tall
; standing pose; per-character scenes (Buffalo, Fox, Val, Goose, Owl) tweak
; bone positions/lengths in their own derivative scenes during rig assembly.
;
; Sprite2D slots are placed at every "fleshy" bone (head, torso, upper_arm,
; forearm, hand, thigh, calf, foot, tail). They start textureless — the
; per-character scene calls CharacterRigController.set_part_atlases() to
; populate AtlasTextures from the rigging sheet.
;
; Goose / Owl note: this template uses arm-chain bone names (shoulder,
; upper_arm, forearm, hand). For wing-based characters the rigger can either
; (a) re-use these bones with wing-shaped AtlasTextures (cheap), or
; (b) instantiate this template and rename the chain to wing/upper_wing/
; lower_wing/wingtip in the derivative scene. The CharacterRigController
; doesn't care about bone names — it operates on logical part names.

[ext_resource type="Script" path="res://scripts/character_rig_controller.gd" id="1_rig"]
[ext_resource type="Script" path="res://scripts/character_animation_controller.gd" id="2_anim"]

[node name="CharacterRigBipedal" type="Node2D"]
script = ExtResource("1_rig")

