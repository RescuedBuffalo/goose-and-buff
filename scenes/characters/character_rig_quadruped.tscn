[gd_scene load_steps=3 format=3]

; Quadruped character rig template (BUF-183).
;
; For Frost Wolf and Winterborn Bear. Body is horizontal — spine extends
; along X from head (front, -X) to tail (back, +X) in the rig's local space.
; Skeleton2D origin is at ground level, between the 4 paws.
;
; Bone positions are placeholder values for a side-profile pose; per-
; character scenes (Wolf, Bear) tweak proportions during rig assembly.
; Wolf is sleeker (longer spine, thinner legs); Bear is heavier (shorter
; legs, broader chest) — both share this structure.
;
; Animation set per the M3 plan:
;   Wolf: idle, walk, lunge, hit_react, frost_shatter_death, aggro_tell
;   Bear: same, with heavier timing
; Per-character scenes call set_animation_name() on their AnimationController
; to remap State.ATTACK -> "lunge" and State.DEATH -> "frost_shatter_death".

[ext_resource type="Script" path="res://scripts/character_rig_controller.gd" id="1_rig"]
[ext_resource type="Script" path="res://scripts/character_animation_controller.gd" id="2_anim"]

[node name="CharacterRigQuadruped" type="Node2D"]
script = ExtResource("1_rig")

[node name="Skeleton2D" type="Skeleton2D" parent="."]

[node name="root" type="Bone2D" parent="Skeleton2D"]
position = Vector2(0, -10)
rest = Transform2D(1, 0, 0, 1, 0, -10)

