[gd_scene load_steps=15 format=3]

; Buffalo character rig (BUF-183 Phase 3) — EDITOR-VISIBLE version.
;
; All AtlasTextures are baked as SubResources directly in this scene,
; assigned to each Sprite2D's `texture` property, with scale + offset set
; on the Sprite2D nodes too. This means opening this scene in Godot's
; 2D editor shows Buffalo composed of his actual parts at their actual
; positions — you can drag bones around in the editor and see the parts
; follow live.
;
; Editing workflow:
;   1. Open this scene in Godot.
;   2. Click any Bone2D in the Skeleton2D tree to select it.
;   3. Drag the bone's pivot (the diamond in the 2D viewport) to move
;      it. The attached Sprite2D + descendant bones follow.
;   4. Use the inspector to set bone position numerically if you prefer.
;   5. Save the scene — the new bone positions persist.
;
; To change an atlas region (e.g. swap to a different head expression),
; click the Sprite2D, then in the inspector under Texture > AtlasTexture,
; edit the Region rect.

[ext_resource type="PackedScene" path="res://scenes/characters/character_rig_bipedal.tscn" id="1_template"]
[ext_resource type="Script" path="res://scripts/characters/buffalo.gd" id="2_buffalo"]
[ext_resource type="Texture2D" path="res://design/assets/characters/buffalo_rigging_sheet.png" id="3_sheet"]

; ─── AtlasTexture sub-resources (one per visible part) ────────────────────
[sub_resource type="AtlasTexture" id="atlas_head"]
atlas = ExtResource("3_sheet")
region = Rect2(349, 55, 166, 148)

[sub_resource type="AtlasTexture" id="atlas_torso"]
atlas = ExtResource("3_sheet")
region = Rect2(582, 392, 210, 160)

[sub_resource type="AtlasTexture" id="atlas_upper_arm_l"]
atlas = ExtResource("3_sheet")
region = Rect2(64, 450, 87, 128)

[sub_resource type="AtlasTexture" id="atlas_upper_arm_r"]
atlas = ExtResource("3_sheet")
region = Rect2(210, 450, 84, 128)

[sub_resource type="AtlasTexture" id="atlas_hand"]
atlas = ExtResource("3_sheet")
region = Rect2(59, 717, 55, 86)

[sub_resource type="AtlasTexture" id="atlas_thigh"]
atlas = ExtResource("3_sheet")
region = Rect2(656, 587, 106, 142)

[sub_resource type="AtlasTexture" id="atlas_calf"]
atlas = ExtResource("3_sheet")
region = Rect2(806, 573, 87, 147)

[sub_resource type="AtlasTexture" id="atlas_tail"]
atlas = ExtResource("3_sheet")
region = Rect2(1036, 615, 72, 97)

; ─── Root + script override ───────────────────────────────────────────────
[node name="Buffalo" instance=ExtResource("1_template")]
script = ExtResource("2_buffalo")

; ─── Spine column bone overrides ──────────────────────────────────────────
[node name="root" parent="Skeleton2D" index="0"]
position = Vector2(0, -29)
rest = Transform2D(1, 0, 0, 1, 0, -29)

[node name="spine" parent="Skeleton2D/root" index="0"]
position = Vector2(0, -16)
rest = Transform2D(1, 0, 0, 1, 0, -16)

[node name="TorsoSprite" parent="Skeleton2D/root/spine" index="0"]
