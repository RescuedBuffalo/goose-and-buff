# Godot 4+ generated cache. Imports and uid files are tracked (they're
# load-bearing references), but the .godot/ directory is per-machine.
.godot/

# Godot exports (we don't ship distributables from this repo).
/build/
/exports/
*.exe
*.pck

# Per-developer tooling — the godot-mcp helper plugin is installed locally
# for live editor control during AI-assisted iteration; not part of the
# prototype itself.
/addons/godot_mcp/
